// Bimbi Toys — Database schema
// dev branch: Postgres (Neon) — deployable to Vercel. See DEPLOYMENT.md.
// (The admin branch keeps the original SQLite provider for zero-config local dev.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  phone         String?
  role          Role      @default(CUSTOMER)
  // "Harga spesial kenalan": percent off every item for this user (0 = none).
  // Set with `npm run user:special email@contoh.com`.
  discountPercent Int     @default(0)
  createdAt     DateTime  @default(now())

  wishlist      WishlistItem[]
  cartItems     CartItem[]
  orders        Order[]
  addresses     Address[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  emoji    String?   // playful category icon, e.g. "🧸"
  products Product[]
}

model Product {
  id            String    @id @default(cuid())
  name          String
  // Buyer-facing name shown in the shop. `name` stays the warehouse original
  // so the admin panel still matches the client's own POS records.
  displayName   String?
  slug          String    @unique
  description   String
  price         Int       // in IDR, smallest unit (Rupiah, no decimals)
  compareAtPrice Int?     // for "coret harga" discount display
  stock         Int       @default(0)
  minAge        Int?      // recommended minimum age
  images        ProductImage[]
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  // The POS `Kode` from the client's inventory export. Nullable because older
  // rows predate it. This is the stable key for re-imports and the planned
  // SQLite sync — matching on name is fragile once names get edited.
  sku           String?   @unique
  featured      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  // Set once the auto-fill has searched for this product and found nothing
  // usable. Without it a product that Serper can't match is re-searched on
  // every run, paying the credit again each time for the same failure.
  imageSearchedAt DateTime?

  wishlistedBy  WishlistItem[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  stockByStore  StoreStock[]
  shelves       ProductShelf[]

  @@index([categoryId])
  @@index([featured])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int      @default(0)

  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model StoreLocation {
  id        String   @id @default(cuid())
  name      String
  city      String
  address   String
  lat       Float
  lng       Float
  phone     String?
  stock     StoreStock[]
  orders    Order[]
  shelves   Shelf[]
}

model StoreStock {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  quantity  Int      @default(0)
  store     StoreLocation @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([productId])
}

// ---- "Lihat Ada Apa di Toko" shelf system ---------------------------------
// A Shelf is one physical shelf/rack inside a store; ShelfCategory groups
// shelves on the browsing page (e.g. "Mainan Bayi"). ShelfCategory is separate
// from the product Category on purpose: it describes store sections, not the
// product taxonomy, and admins curate it independently.
model ShelfCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  position Int     @default(0)
  shelves  Shelf[]
}

model Shelf {
  id          String        @id @default(cuid())
  storeId     String
  store       StoreLocation @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    ShelfCategory @relation(fields: [categoryId], references: [id])
  name        String
  // Short physical code printed on the rack, e.g. "EDU-04". Unique per store.
  code        String
  description String?
  // Photo of the physical shelf (uploaded via the admin panel).
  image       String?
  position    Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    ProductShelf[]

  @@unique([storeId, code])
  @@index([storeId, active])
  @@index([categoryId])
}

// Join model: the same product can sit on many shelves across many stores,
// and a shelf holds many products — so no `shelfId` column on Product.
model ProductShelf {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shelfId   String
  shelf     Shelf    @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([productId, shelfId])
  @@index([shelfId])
  @@index([productId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String  // e.g. "Rumah", "Kantor"
  recipient  String
  phone      String
  province   String
  city       String
  district   String
  postalCode String
  detail     String  // street, house number, notes
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([userId])
}

enum FulfillmentType {
  PICKUP
  SHIPPING
  SELF_COURIER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PACKED
  SHIPPED
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  EXPIRED
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique // human-friendly, e.g. BIMBI-20260705-0001
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  items           OrderItem[]
  fulfillment     FulfillmentType
  storeId         String?
  store           StoreLocation?  @relation(fields: [storeId], references: [id])
  addressId       String?
  address         Address?        @relation(fields: [addressId], references: [id])
  shippingCourier String?         // e.g. "JNE REG", "SiCepat BEST"
  shippingCost    Int             @default(0)
  contactPhone    String?         // buyer's WA number, captured at checkout (62xxx format)
  subtotal        Int
  total           Int
  status          OrderStatus     @default(PENDING_PAYMENT)
  midtransOrderId String?         @unique
  qrisUrl         String?         // QR code image URL returned by Midtrans
  paidAt          DateTime?
  createdAt       DateTime        @default(now())

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int     // price at time of purchase

  @@index([orderId])
  @@index([productId])
}
